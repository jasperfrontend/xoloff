APP_NAME=Xoloff
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=xoloff
DB_USERNAME=xoloff
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# Xolution's own relay, which is where a sent quote leaves from (SPEC §7).
# .nu is not a typo: the mail addresses live on .nl and the SMTP host does
# not. Set these and MAIL_MAILER=smtp to actually send; leave MAIL_MAILER=log
# and quotes are written to the log instead, which is what you want locally.
#
# XOL_PORT defaults to 587, which is submission with STARTTLS. If the relay
# turns out to listen on 465 instead, that is implicit TLS and the port alone
# is not enough: set MAIL_SCHEME=smtps as well, because Laravel does not infer
# it from the port. 2525 is the other common alternative and behaves like 587.
#
# XOL_USER is only needed if the relay authenticates as something other than
# the address it sends from.
XOL_SMTP=smtp.xolution.nu
XOL_PORT=587
XOL_FROM=
XOL_USER=
XOL_PASS=

# The fallbacks, used when the XOL_ keys above are absent. The from name is
# only ever a fallback: App\Mail\QuoteSent puts the company name from the
# settings screen beside the address, so the customer's inbox shows Xolution
# rather than this tool.
MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

# The Chromium container that renders quote PDFs. Without a URL the download
# button explains that it is not configured rather than failing.
#
# The two credential names are Gotenberg's own, so the same pair goes into
# the container's environment and into this file unchanged. Basic auth is
# switched on at the container with API_ENABLE_BASIC_AUTH=true - note the
# missing GOTENBERG_ prefix, which is Gotenberg's asymmetry and not a typo.
# Nothing switches it on here: this application sends credentials whenever it
# has them.
GOTENBERG_URL=
GOTENBERG_API_BASIC_AUTH_USERNAME=
GOTENBERG_API_BASIC_AUTH_PASSWORD=

VITE_APP_NAME="${APP_NAME}"
